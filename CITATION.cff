    given-names: Alessandro
    affiliation: >-
      Persuasive Technology Lab, University of Lausanne; School of
      Management of Fribourg, HES-SO University of Applied Sciences and
      Arts Western Switzerland
license: Apache-2.0
# Uncomment and fill in once the repository is public:
# repository-code: "https://github.com/<owner>/<repo>"
keywords:
  - physical activity
  - conversational agents
  - simulated exercising peers
  - research software

